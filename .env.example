# Copy this file to .env for local development. Never commit .env or real credentials.
PORT=10000

# PostgreSQL connection string for a database initialized with database/schema.sql
DATABASE_URL=

# Twilio Verify credentials (leave blank to use the local demo OTP flow)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Google OAuth web client ID (leave blank if Google sign-in is not configured)
GOOGLE_CLIENT_ID=
